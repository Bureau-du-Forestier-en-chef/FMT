; Complex yields with values computed by hand, for testScenarioReading.
*YC ? ? ?
FIRST _EQUATION(2*3)
SECOND _EQUATION(10/2)
EQUATIONSUM _EQUATION(FIRST+SECOND)
POWERFIRST _EQUATION(2^3*2)
PARENTHESES _EQUATION(2*(3^2))
PRECEDENCE _EQUATION(2*3^2)
SUMOFYIELDS _SUM(FIRST,SECOND)
SUMWITHCONSTANT _SUM(FIRST,4)
SUMOFAGEYIELDS _SUM(VOLUMETOTAL,VOLUMETOTAL)
PRODUCT _MULTIPLY(FIRST,SECOND)
QUOTIENT _DIVIDE(FIRST,SECOND)
SUBTRACTION _SUBTRACT(FIRST,SECOND)
INRANGE _RANGE(VOLUMETOTAL,100,200)
GROWTH _MAI(VOLUMETOTAL)
CONSTANT _EQUATION(#TWO*3)
