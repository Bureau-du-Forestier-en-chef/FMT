foreach PEUP in (peuplement1,peuplement2,peuplement3)
	*Y ? PEUP ?
	_AGE volumetotal
	FOREACH ROW in .\TWD_land.db QUERY(
			SELECT age, volumetotal
			FROM yields
			WHERE stand_name = 'PEUP' and age >= #ctest
			ORDER BY age
			)
		ROW.age ROW.volumetotal
	ENDFOR
ENDFOR


*YC ? ? ?
YBM_RTM_BOG _EQUATION(1.2159259330000001*10^0.87191668899999997)
YBM_RTM_F _SUM(YBM_RTM_BOG,YBM_RTM_MEH)
YBM_RTM_MEH _EQUATION(1.1017722459999999*12^0.83493872400000002)

*Y ? ? ?
_AGE volumezero
0    0