#[[
Generates CoreTestCoverage.md, the inventory of the classes of namespace Core and of their tests asked by
issue #350. Run in script mode, from any folder:

    cmake -P Documentation/Testing/CoreTestCoverage.cmake

FMT_ROOT, the root of the repository, defaults to the folder two levels above this script.

What it reads:
- the headers of Include/: every class or struct defined in namespace Core, templates and public nested
  classes included. Forward declarations, friend declarations, explicit instantiations and explicit
  specializations are left out;
- the GoogleTest cases of Tests/Unit and Tests/Integration, TEST(<Suite>, <Case>), counted by suite. A suite
  is named after the class under test (CodingStandards.md, Test names);
- CoreTestCoverage.csv, next to this script: the columns written by hand, one row per class.

What it writes:
- CoreTestCoverage.csv again, sorted by class, with the hand-written values kept. A class found for the first
  time gets a row with empty values. A class no longer found keeps its row, with REMOVED as its header, until
  someone moves its values or deletes the row;
- CoreTestCoverage.md, in UTF-8 with CRLF line endings.
The classes that appeared or disappeared since the previous generation are printed and listed in the
document. The script fails only when it cannot read its inputs or a row of the CSV.

The headers are read as bytes, since some are encoded in cp1252: only identifiers and punctuation matter.
Before CMake turns a text into a list, the characters that would split or nest an item (; [ ] \) are replaced
by control characters. Comments and literals are removed in one pass, so that "/*" in a string does not open
a comment, then the preprocessor lines. The remaining text is cut into the tokens that open or close a scope
(namespace, class or struct, braces) and the access specifiers, which a stack follows.
]]

cmake_minimum_required(VERSION 3.19)

if(NOT DEFINED FMT_ROOT)
    get_filename_component(FMT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
set(_coverageCsv "${CMAKE_CURRENT_LIST_DIR}/CoreTestCoverage.csv")
set(_coverageMd "${CMAKE_CURRENT_LIST_DIR}/CoreTestCoverage.md")

# The columns of the CSV. Header is written by the script; the others are written by hand.
set(_coverageColumns Class Header Priority SystemTests IntegrationIndirect KnownIssues Remarks Status
    PublicOperations ExternalDependencies ThreadSafety AllocationSensitive MissingTests)

string(ASCII 1 _cSemicolon)
string(ASCII 2 _cBackslash)
string(ASCII 3 _cOpenBracket)
string(ASCII 4 _cCloseBracket)
string(ASCII 5 _cBreak)
set(_ws "[ \t\r\n]")
# _cBreak splits a keyword inside an identifier (_coverageCleanHeader), and is removed from the names found.
set(_identifier "[A-Za-z_][A-Za-z0-9_${_cBreak}]*")

# Replaces the characters that would split or nest a list item.
function(_coverageProtect p_out p_text)
    string(REPLACE "\\" "${_cBackslash}" p_text "${p_text}")
    string(REPLACE ";" "${_cSemicolon}" p_text "${p_text}")
    string(REPLACE "[" "${_cOpenBracket}" p_text "${p_text}")
    string(REPLACE "]" "${_cCloseBracket}" p_text "${p_text}")
    set(${p_out} "${p_text}" PARENT_SCOPE)
endfunction()

# Restores the characters that _coverageProtect replaced.
function(_coverageRestore p_out p_text)
    string(REPLACE "${_cBackslash}" "\\" p_text "${p_text}")
    string(REPLACE "${_cSemicolon}" ";" p_text "${p_text}")
    string(REPLACE "${_cOpenBracket}" "[" p_text "${p_text}")
    string(REPLACE "${_cCloseBracket}" "]" p_text "${p_text}")
    set(${p_out} "${p_text}" PARENT_SCOPE)
endfunction()

# Removes the comments and empties the string and character literals of a protected text. A backslash and
# the character it escapes form one token, so that an escaped quote does not close a literal, and a backslash
# at the end of a line comment continues it.
function(_coverageStripComments p_out p_text)
    string(REGEX MATCHALL "/\\*|\\*/|//|[\"'\n]|${_cBackslash}.|[^/*\"'\n${_cBackslash}]+|[/*]" _tokens "${p_text}")
    set(_state code)
    set(_result "")
    foreach(_token IN LISTS _tokens)
        if(_state STREQUAL "code")
            if(_token STREQUAL "/*")
                set(_state block)
                string(APPEND _result " ")
            elseif(_token STREQUAL "//")
                set(_state line)
            elseif(_token STREQUAL "\"")
                set(_state string)
                string(APPEND _result "\"\"")
            elseif(_token STREQUAL "'")
                set(_state character)
                string(APPEND _result "''")
            else()
                string(APPEND _result "${_token}")
            endif()
        elseif(_state STREQUAL "block")
            if(_token STREQUAL "*/")
                set(_state code)
            endif()
        elseif(_state STREQUAL "line")
            if(_token STREQUAL "\n")
                set(_state code)
                string(APPEND _result "\n")
            endif()
        elseif(_state STREQUAL "string")
            if(_token STREQUAL "\"" OR _token STREQUAL "\n")
                set(_state code)
            endif()
        elseif(_token STREQUAL "'" OR _token STREQUAL "\n")
            set(_state code)
        endif()
    endforeach()
    set(${p_out} "${_result}" PARENT_SCOPE)
endfunction()

# Prepares the protected text of a header for the tokens: no comment, no literal, no preprocessor line, and
# no keyword inside an identifier (mydeclass), so that a token can only start where the keyword does.
function(_coverageCleanHeader p_out p_text)
    _coverageStripComments(p_text "${p_text}")
    string(REGEX REPLACE "\n[ \t]*#([^\n]*${_cBackslash}\r?\n)*[^\n]*" "\n" p_text "\n${p_text}")
    string(REGEX REPLACE "enum${_ws}+(class|struct)(${_ws})" "enum\\2" p_text "${p_text}")
    string(REGEX REPLACE "([<,]${_ws}*)class(${_ws})" "\\1typename\\2" p_text "${p_text}")
    foreach(_keyword class struct namespace public protected private template serialize)
        string(SUBSTRING "${_keyword}" 0 1 _first)
        string(SUBSTRING "${_keyword}" 1 -1 _rest)
        string(REGEX REPLACE "([A-Za-z0-9_])${_keyword}" "\\1${_first}${_cBreak}${_rest}" p_text "${p_text}")
        string(REGEX REPLACE "${_keyword}([A-Za-z0-9_])" "${_first}${_cBreak}${_rest}\\1" p_text "${p_text}")
    endforeach()
    set(${p_out} "${p_text}" PARENT_SCOPE)
endfunction()

# Turns a qualified class name into a part of a variable name.
function(_coverageKey p_out p_class)
    string(REPLACE "::" "__" p_class "${p_class}")
    set(${p_out} "${p_class}" PARENT_SCOPE)
endfunction()

# Formats a hand-written value for a cell of a Markdown table.
function(_coverageCell p_out p_value)
    _coverageRestore(p_value "${p_value}")
    string(REPLACE "|" "\\|" p_value "${p_value}")
    set(${p_out} "${p_value}" PARENT_SCOPE)
endfunction()

# Writes a text with CRLF line endings on every platform: file(WRITE) would translate the line endings on
# Windows only. file(CONFIGURE) replaces @NAME@ markers, so @ is written as @AT@ and restored by it.
function(_coverageWrite p_file p_text)
    set(AT "@")
    string(REPLACE "@" "@AT@" p_text "${p_text}")
    file(CONFIGURE OUTPUT "${p_file}" CONTENT "${p_text}" @ONLY NEWLINE_STYLE CRLF)
endfunction()

# Classes of the headers.
set(_classHead "(template${_ws}*<[^{}${_cSemicolon}]*>${_ws}*)?(class|struct)${_ws}+(FMTEXPORT${_ws}+)?(${_identifier}(::${_identifier})*)([^${_cSemicolon}{}()]*)([${_cSemicolon}{])")
set(_namespaceHead "namespace(${_ws}+${_identifier}(::${_identifier})*)?${_ws}*{")
set(_accessSpecifier "(public|protected|private)${_ws}*:")
set(_serialization "serialize${_ws}*\\(|BOOST_SERIALIZATION_SPLIT_MEMBER")
set(_classes "")
set(_specializations "")
file(GLOB _headers LIST_DIRECTORIES false "${FMT_ROOT}/Include/*.h" "${FMT_ROOT}/Include/*.hpp")
if(NOT _headers)
    message(FATAL_ERROR "No header in ${FMT_ROOT}/Include: set FMT_ROOT to the root of the repository.")
endif()
list(SORT _headers)
foreach(_header IN LISTS _headers)
    get_filename_component(_headerName "${_header}" NAME)
    file(READ "${_header}" _raw)
    _coverageProtect(_text "${_raw}")
    _coverageCleanHeader(_text "${_text}")
    string(REGEX MATCHALL "${_classHead}|${_namespaceHead}|${_accessSpecifier}|${_serialization}|[{}]" _tokens "${_text}")
    # Each item of the stack is a namespace (N|<name>), a class (C|<qualified name>|<access>|<inventoried>)
    # or any other brace (O).
    set(_stack "")
    set(_headerClasses "")
    foreach(_token IN LISTS _tokens)
        if(_token MATCHES "^namespace")
            string(REGEX MATCH "^namespace${_ws}+(${_identifier}(::${_identifier})*)" _match "${_token}")
            if(_match)
                string(REPLACE "${_cBreak}" "" _namespace "${CMAKE_MATCH_1}")
                list(APPEND _stack "N|${_namespace}")
            else()
                list(APPEND _stack "N|")
            endif()
        elseif(_token MATCHES "^(template|class|struct)")
            string(REGEX MATCH "^${_classHead}$" _match "${_token}")
            if(NOT CMAKE_MATCH_7 STREQUAL "{")
                continue()
            endif()
            set(_kind "${CMAKE_MATCH_2}")
            string(REPLACE "${_cBreak}" "" _name "${CMAKE_MATCH_4}")
            set(_isTemplate FALSE)
            if(CMAKE_MATCH_1)
                set(_isTemplate TRUE)
            endif()
            set(_isExported FALSE)
            if(CMAKE_MATCH_3)
                set(_isExported TRUE)
            endif()
            set(_isSpecialization FALSE)
            if(CMAKE_MATCH_6 MATCHES "^${_ws}*<")
                set(_isSpecialization TRUE)
            endif()
            # Inventoried: directly in namespace Core, or nested under public access in an inventoried class.
            set(_namespaces "")
            set(_outer "")
            set(_inventoried TRUE)
            foreach(_item IN LISTS _stack)
                string(REPLACE "|" ";" _fields "${_item}")
                list(GET _fields 0 _itemKind)
                if(_itemKind STREQUAL "N")
                    list(GET _fields 1 _itemName)
                    list(APPEND _namespaces "${_itemName}")
                elseif(_itemKind STREQUAL "C")
                    list(GET _fields 1 _outer)
                    list(GET _fields 2 _itemAccess)
                    list(GET _fields 3 _itemInventoried)
                    if(NOT _itemAccess STREQUAL "public" OR NOT _itemInventoried)
                        set(_inventoried FALSE)
                    endif()
                else()
                    set(_inventoried FALSE)
                endif()
            endforeach()
            if(NOT _namespaces STREQUAL "Core")
                set(_inventoried FALSE)
            endif()
            if(_outer)
                set(_name "${_outer}::${_name}")
            endif()
            if(_inventoried AND _isSpecialization)
                list(APPEND _specializations "${_name} (${_headerName})")
                set(_inventoried FALSE)
            endif()
            if(_inventoried)
                _coverageKey(_key "${_name}")
                if(DEFINED _header_${_key})
                    message(WARNING "${_headerName}: Core::${_name} is already defined in ${_header_${_key}}; the first definition is kept.")
                    set(_inventoried FALSE)
                else()
                    list(APPEND _classes "${_name}")
                    list(APPEND _headerClasses "${_name}")
                    set(_header_${_key} "${_headerName}")
                    set(_template_${_key} ${_isTemplate})
                    set(_exported_${_key} ${_isExported})
                    set(_serialized_${_key} FALSE)
                endif()
            endif()
            if(_kind STREQUAL "struct")
                list(APPEND _stack "C|${_name}|public|${_inventoried}")
            else()
                list(APPEND _stack "C|${_name}|private|${_inventoried}")
            endif()
        elseif(_token MATCHES "^(public|protected|private)")
            set(_access "${CMAKE_MATCH_1}")
            list(LENGTH _stack _depth)
            if(_depth GREATER 0)
                list(GET _stack -1 _top)
                if(_top MATCHES "^C\\|([^|]*)\\|[^|]*\\|(.*)$")
                    list(POP_BACK _stack)
                    list(APPEND _stack "C|${CMAKE_MATCH_1}|${_access}|${CMAKE_MATCH_2}")
                endif()
            endif()
        elseif(_token MATCHES "^(serialize|BOOST_SERIALIZATION_SPLIT_MEMBER)")
            list(LENGTH _stack _depth)
            if(_depth GREATER 0)
                list(GET _stack -1 _top)
                if(_top MATCHES "^C\\|([^|]*)\\|[^|]*\\|TRUE$")
                    _coverageKey(_key "${CMAKE_MATCH_1}")
                    set(_serialized_${_key} TRUE)
                endif()
            endif()
        elseif(_token STREQUAL "{")
            list(APPEND _stack "O")
        else()
            list(LENGTH _stack _depth)
            if(_depth EQUAL 0)
                message(WARNING "${_headerName}: a closing brace has no opening brace; the classes of this header may be wrong.")
            else()
                list(POP_BACK _stack)
            endif()
        endif()
    endforeach()
    if(_stack)
        message(WARNING "${_headerName}: ${_stack} still open at the end of the header; the classes of this header may be wrong.")
    endif()
    if(NOT _headerClasses)
        continue()
    endif()
    # What the header and its source say about dependencies, build options and threads.
    get_filename_component(_base "${_header}" NAME_WE)
    set(_source "")
    set(_sourceText "")
    if(EXISTS "${FMT_ROOT}/Source/${_base}.cpp")
        set(_source "Source/${_base}.cpp")
        file(READ "${FMT_ROOT}/Source/${_base}.cpp" _sourceText)
        _coverageProtect(_sourceText "${_sourceText}")
    endif()
    _coverageProtect(_both "${_raw}${_sourceText}")
    set(_dependencies "")
    if(_both MATCHES "onnxruntime|FMTWITHONNXR")
        list(APPEND _dependencies "ONNX Runtime")
    endif()
    if(_both MATCHES "FMTWITHGDAL|gdal|ogr_")
        list(APPEND _dependencies "GDAL")
    endif()
    if(_both MATCHES "FMTWITHOSI|Osi[A-Z][A-Za-z]*\\.h|mosek")
        list(APPEND _dependencies "OSI solvers")
    endif()
    if(_both MATCHES "FMTWITHR[^A-Za-z]|Rcpp")
        list(APPEND _dependencies "R (Rcpp)")
    endif()
    if(_both MATCHES "FMTWITHPYTHON|boost/python")
        list(APPEND _dependencies "Python")
    endif()
    string(REGEX MATCHALL "#[ \t]*(if|ifdef|ifndef|elif)[^\n]*FMTWITH[A-Z]+" _guardLines "${_both}")
    set(_guards "")
    foreach(_line IN LISTS _guardLines)
        string(REGEX MATCHALL "FMTWITH[A-Z]+" _names "${_line}")
        list(APPEND _guards ${_names})
    endforeach()
    list(REMOVE_DUPLICATES _guards)
    set(_threads "")
    if(_both MATCHES "mutex")
        set(_threads "Uses a mutex")
    endif()
    foreach(_name IN LISTS _headerClasses)
        _coverageKey(_key "${_name}")
        set(_source_${_key} "${_source}")
        set(_dependencies_${_key} "${_dependencies}")
        set(_guards_${_key} "${_guards}")
        set(_threads_${_key} "${_threads}")
    endforeach()
endforeach()
list(LENGTH _classes _classCount)
if(_classCount EQUAL 0)
    message(FATAL_ERROR "No class of namespace Core found in ${FMT_ROOT}/Include.")
endif()

# GoogleTest cases, counted by level and suite.
foreach(_level Unit Integration)
    set(_suites_${_level} "")
    file(GLOB_RECURSE _testFiles LIST_DIRECTORIES false
        "${FMT_ROOT}/Tests/${_level}/*.cpp" "${FMT_ROOT}/Tests/${_level}/*.h" "${FMT_ROOT}/Tests/${_level}/*.hpp")
    list(SORT _testFiles)
    foreach(_testFile IN LISTS _testFiles)
        file(READ "${_testFile}" _text)
        _coverageProtect(_text "${_text}")
        _coverageStripComments(_text "${_text}")
        string(REGEX MATCHALL "TEST(_F|_P)?${_ws}*\\(${_ws}*${_identifier}${_ws}*,${_ws}*${_identifier}" _cases "${_text}")
        foreach(_case IN LISTS _cases)
            string(REGEX MATCH "\\(${_ws}*(${_identifier})${_ws}*,${_ws}*(${_identifier})" _match "${_case}")
            set(_suite "${CMAKE_MATCH_1}")
            set(_caseName "${CMAKE_MATCH_2}")
            if(NOT DEFINED _cases_${_level}_${_suite})
                list(APPEND _suites_${_level} "${_suite}")
                set(_cases_${_level}_${_suite} 0)
                set(_disabled_${_level}_${_suite} 0)
            endif()
            math(EXPR _cases_${_level}_${_suite} "${_cases_${_level}_${_suite}} + 1")
            if(_caseName MATCHES "^DISABLED_")
                math(EXPR _disabled_${_level}_${_suite} "${_disabled_${_level}_${_suite}} + 1")
            endif()
        endforeach()
    endforeach()
endforeach()

# Hand-written columns of the CSV.
set(_csvClasses "")
if(EXISTS "${_coverageCsv}")
    file(READ "${_coverageCsv}" _csvText)
    _coverageProtect(_csvText "${_csvText}")
    string(REPLACE "\r" "" _csvText "${_csvText}")
    string(REGEX REPLACE "\n+$" "" _csvText "${_csvText}")
    string(REPLACE "\n" ";" _csvLines "${_csvText}")
    list(POP_FRONT _csvLines _csvHeader)
    string(REPLACE "${_cSemicolon}" ";" _csvHeader "${_csvHeader}")
    list(LENGTH _csvHeader _csvWidth)
    foreach(_column IN LISTS _coverageColumns)
        list(FIND _csvHeader "${_column}" _index_${_column})
    endforeach()
    if(_index_Class EQUAL -1)
        message(FATAL_ERROR "${_coverageCsv}: the first line has no column Class.")
    endif()
    set(_lineNumber 1)
    foreach(_line IN LISTS _csvLines)
        math(EXPR _lineNumber "${_lineNumber} + 1")
        if(_line STREQUAL "")
            continue()
        endif()
        string(REPLACE "${_cSemicolon}" ";" _fields "${_line}")
        list(LENGTH _fields _width)
        if(NOT _width EQUAL _csvWidth)
            message(FATAL_ERROR "${_coverageCsv}:${_lineNumber}: ${_width} fields instead of ${_csvWidth}; a value cannot hold a semicolon.")
        endif()
        list(GET _fields ${_index_Class} _name)
        _coverageKey(_key "${_name}")
        if(DEFINED _csvRow_${_key})
            message(FATAL_ERROR "${_coverageCsv}:${_lineNumber}: ${_name} has a row already.")
        endif()
        set(_csvRow_${_key} TRUE)
        list(APPEND _csvClasses "${_name}")
        foreach(_column IN LISTS _coverageColumns)
            if(_index_${_column} EQUAL -1)
                set(_hand_${_column}_${_key} "")
            else()
                list(GET _fields ${_index_${_column}} _hand_${_column}_${_key})
            endif()
        endforeach()
    endforeach()
else()
    message(STATUS "No ${_coverageCsv} yet: every class gets an empty row.")
endif()

# Classes that appeared or disappeared since the previous generation.
set(_added "")
foreach(_name IN LISTS _classes)
    _coverageKey(_key "${_name}")
    if(NOT DEFINED _csvRow_${_key})
        list(APPEND _added "${_name}")
        foreach(_column IN LISTS _coverageColumns)
            set(_hand_${_column}_${_key} "")
        endforeach()
        set(_hand_Class_${_key} "${_name}")
    endif()
endforeach()
set(_removed "")
foreach(_name IN LISTS _csvClasses)
    _coverageKey(_key "${_name}")
    if(NOT DEFINED _header_${_key})
        list(APPEND _removed "${_name}")
    endif()
endforeach()
foreach(_name IN LISTS _added)
    message(STATUS "New class: Core::${_name}")
endforeach()
foreach(_name IN LISTS _removed)
    message(STATUS "Class no longer found: Core::${_name} (its row is kept, marked REMOVED)")
endforeach()

# The CSV again, sorted by class.
set(_allClasses ${_classes} ${_removed})
list(SORT _allClasses)
list(JOIN _coverageColumns ";" _csvOut)
string(APPEND _csvOut "\n")
foreach(_name IN LISTS _allClasses)
    _coverageKey(_key "${_name}")
    if(DEFINED _header_${_key})
        set(_hand_Header_${_key} "${_header_${_key}}")
    else()
        set(_hand_Header_${_key} "REMOVED")
    endif()
    set(_hand_Class_${_key} "${_name}")
    set(_row "")
    foreach(_column IN LISTS _coverageColumns)
        _coverageRestore(_value "${_hand_${_column}_${_key}}")
        string(APPEND _row "${_value};")
    endforeach()
    string(REGEX REPLACE ";$" "\n" _row "${_row}")
    string(APPEND _csvOut "${_row}")
endforeach()
_coverageWrite("${_coverageCsv}" "${_csvOut}")

# Rows of the document, sorted by priority, then header, then class.
set(_sortKeys "")
foreach(_name IN LISTS _classes)
    _coverageKey(_key "${_name}")
    set(_priority "${_hand_Priority_${_key}}")
    if(_priority STREQUAL "")
        set(_priority "?")
    endif()
    set(_priority_${_key} "${_priority}")
    list(APPEND _sortKeys "${_priority}|${_header_${_key}}|${_name}")
endforeach()
list(SORT _sortKeys)

set(_priorityCount_1 0)
set(_priorityCount_2 0)
set(_priorityCount_3 0)
set(_priorityCount_unknown 0)
set(_withUnit 0)
set(_untestedPriority1 "")
set(_trackingRows "")
set(_descriptionRows "")
foreach(_sortKey IN LISTS _sortKeys)
    string(REGEX REPLACE "^[^|]*\\|[^|]*\\|" "" _name "${_sortKey}")
    _coverageKey(_key "${_name}")
    set(_priority "${_priority_${_key}}")
    if(_priority MATCHES "^[123]$")
        math(EXPR _priorityCount_${_priority} "${_priorityCount_${_priority}} + 1")
    else()
        math(EXPR _priorityCount_unknown "${_priorityCount_unknown} + 1")
    endif()
    # Test counts of the suite named after the class.
    foreach(_level Unit Integration)
        if(DEFINED _cases_${_level}_${_name})
            set(_count "${_cases_${_level}_${_name}}")
            if(_disabled_${_level}_${_name} GREATER 0)
                string(APPEND _count " (${_disabled_${_level}_${_name}} disabled)")
            endif()
        else()
            set(_count "0")
        endif()
        set(_count_${_level} "${_count}")
    endforeach()
    if(DEFINED _cases_Unit_${_name})
        math(EXPR _withUnit "${_withUnit} + 1")
    elseif(_priority STREQUAL "1" AND NOT DEFINED _cases_Integration_${_name})
        list(APPEND _untestedPriority1 "${_name}")
    endif()
    _coverageCell(_indirect "${_hand_IntegrationIndirect_${_key}}")
    if(NOT _indirect STREQUAL "")
        string(APPEND _count_Integration "; indirectly: ${_indirect}")
    endif()
    _coverageCell(_system "${_hand_SystemTests_${_key}}")
    if(_system STREQUAL "")
        set(_system "Not reviewed")
    endif()
    _coverageCell(_issues "${_hand_KnownIssues_${_key}}")
    if(_issues STREQUAL "")
        set(_issues "None known")
    endif()
    set(_remarks "")
    if(_template_${_key})
        set(_remarks "Template, defined in its header.")
    elseif(NOT _exported_${_key})
        set(_remarks "Not exported (no `FMTEXPORT`).")
    endif()
    _coverageCell(_handRemarks "${_hand_Remarks_${_key}}")
    if(NOT _handRemarks STREQUAL "")
        if(_remarks STREQUAL "")
            set(_remarks "${_handRemarks}")
        else()
            string(APPEND _remarks " ${_handRemarks}")
        endif()
    endif()
    _coverageCell(_status "${_hand_Status_${_key}}")
    if(_status STREQUAL "")
        set(_status "Not planned")
    endif()
    string(APPEND _trackingRows "| ${_priority} | `${_header_${_key}}` | `${_name}` | ${_count_Unit} | ${_count_Integration} | ${_system} | ${_issues} | ${_remarks} | ${_status} |\n")

    # Descriptive columns of issue #350.
    if(_source_${_key} STREQUAL "")
        set(_sourceCell "None")
    else()
        set(_sourceCell "`${_source_${_key}}`")
    endif()
    _coverageCell(_operations "${_hand_PublicOperations_${_key}}")
    if(_operations STREQUAL "")
        set(_operations "See the header")
    endif()
    list(JOIN _dependencies_${_key} ", " _dependenciesCell)
    _coverageCell(_handDependencies "${_hand_ExternalDependencies_${_key}}")
    if(NOT _handDependencies STREQUAL "")
        if(_dependenciesCell STREQUAL "")
            set(_dependenciesCell "${_handDependencies}")
        else()
            string(APPEND _dependenciesCell "; ${_handDependencies}")
        endif()
    endif()
    if(_dependenciesCell STREQUAL "")
        set(_dependenciesCell "Boost only")
    endif()
    if(_guards_${_key})
        list(JOIN _guards_${_key} "`, `" _guardsCell)
        set(_guardsCell "Code under `${_guardsCell}`")
    else()
        set(_guardsCell "None found")
    endif()
    if(_serialized_${_key})
        set(_serializedCell "Boost serialization")
    else()
        set(_serializedCell "None")
    endif()
    _coverageCell(_threadsCell "${_hand_ThreadSafety_${_key}}")
    if(NOT _threads_${_key} STREQUAL "")
        if(_threadsCell STREQUAL "")
            set(_threadsCell "${_threads_${_key}}")
        else()
            set(_threadsCell "${_threads_${_key}}; ${_threadsCell}")
        endif()
    endif()
    if(_threadsCell STREQUAL "")
        set(_threadsCell "To assess (lot 9)")
    endif()
    _coverageCell(_allocationCell "${_hand_AllocationSensitive_${_key}}")
    if(_allocationCell STREQUAL "")
        set(_allocationCell "To assess (lot 9)")
    endif()
    _coverageCell(_missing "${_hand_MissingTests_${_key}}")
    if(_missing STREQUAL "")
        set(_missing "Not listed yet")
    endif()
    string(APPEND _descriptionRows "| `${_name}` | ${_sourceCell} | ${_operations} | ${_dependenciesCell} | ${_guardsCell} | ${_serializedCell} | ${_threadsCell} | ${_allocationCell} | ${_missing} |\n")
endforeach()

# Suites that name no class of Core.
set(_otherSuites "")
foreach(_level Unit Integration)
    foreach(_suite IN LISTS _suites_${_level})
        if(NOT DEFINED _header_${_suite})
            list(APPEND _otherSuites "`${_suite}` (${_level}, cases: ${_cases_${_level}_${_suite}})")
        endif()
    endforeach()
endforeach()

# The document.
set(_md "")
file(READ "${CMAKE_CURRENT_LIST_DIR}/CoreTestCoverage.md.in" _template)
string(REPLACE "\r" "" _template "${_template}")
# The comment that opens the template speaks to its editors: it stays out of the document.
string(REGEX REPLACE "^<!--[^>]*-->\n" "" _template "${_template}")

set(_changes "")
if(NOT _added AND NOT _removed)
    set(_changes "None: the classes are those of the previous generation.\n")
endif()
foreach(_name IN LISTS _added)
    string(APPEND _changes "- New: `Core::${_name}`. Its row of the CSV is empty: give it a priority.\n")
endforeach()
foreach(_name IN LISTS _removed)
    string(APPEND _changes "- No longer found: `Core::${_name}`. Its row of the CSV is kept, marked `REMOVED`: move its values to the class that replaces it, or delete the row.\n")
endforeach()
if(_specializations)
    list(JOIN _specializations ", " _specializationList)
    string(APPEND _changes "\nExplicit specializations, left out of the inventory: ${_specializationList}.\n")
endif()

set(_untested "")
foreach(_name IN LISTS _untestedPriority1)
    _coverageKey(_key "${_name}")
    _coverageCell(_issues "${_hand_KnownIssues_${_key}}")
    if(_issues STREQUAL "")
        set(_issues "None known")
    endif()
    _coverageCell(_status "${_hand_Status_${_key}}")
    if(_status STREQUAL "")
        set(_status "Not planned")
    endif()
    string(APPEND _untested "| `${_header_${_key}}` | `${_name}` | ${_issues} | ${_status} |\n")
endforeach()
list(LENGTH _untestedPriority1 _untestedCount)
if(_untestedCount EQUAL 0)
    set(_untested "| | None | | |\n")
endif()

if(_otherSuites)
    list(JOIN _otherSuites ", " _otherSuitesText)
else()
    set(_otherSuitesText "none")
endif()

string(REPLACE "@CLASS_COUNT@" "${_classCount}" _template "${_template}")
string(REPLACE "@PRIORITY_1@" "${_priorityCount_1}" _template "${_template}")
string(REPLACE "@PRIORITY_2@" "${_priorityCount_2}" _template "${_template}")
string(REPLACE "@PRIORITY_3@" "${_priorityCount_3}" _template "${_template}")
string(REPLACE "@PRIORITY_UNKNOWN@" "${_priorityCount_unknown}" _template "${_template}")
string(REPLACE "@WITH_UNIT@" "${_withUnit}" _template "${_template}")
string(REPLACE "@UNTESTED_COUNT@" "${_untestedCount}" _template "${_template}")
string(REPLACE "@UNTESTED_ROWS@" "${_untested}" _template "${_template}")
string(REPLACE "@OTHER_SUITES@" "${_otherSuitesText}" _template "${_template}")
string(REPLACE "@CHANGES@" "${_changes}" _template "${_template}")
string(REPLACE "@TRACKING_ROWS@" "${_trackingRows}" _template "${_template}")
string(REPLACE "@DESCRIPTION_ROWS@" "${_descriptionRows}" _template "${_template}")
_coverageRestore(_template "${_template}")
_coverageWrite("${_coverageMd}" "${_template}")
message(STATUS "${_classCount} classes of Core, ${_withUnit} with unit tests, ${_untestedCount} of priority 1 without a test of their own: ${_coverageMd}")
